# Copy this file to .env.local and fill in values from the Firebase console
# (Project settings → Your apps → Firebase SDK snippet → Config).
# Never commit real credentials.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini runs only in Firebase Functions (Secret Manager).
# Do not add VITE_GEMINI_API_KEY. See functions/README.md.
